# Copy this file, then fill in the values you use:
#   cp .env.example .env
#
# The CLI loads `.env` from the current working directory (and parents).
# Do not commit `.env`. It is gitignored.

# ---------------------------------------------------------------------------
# Rewriter — required for `adh humanize`
# ---------------------------------------------------------------------------
# OpenAI-compatible Chat Completions. Works with OpenAI, Groq, OpenRouter,
# Together, Fireworks, or a local server (Ollama, vLLM, LM Studio).
#
# Leave OPENAI_API_KEY empty only when OPENAI_BASE_URL points at localhost
# or 127.0.0.1. There is no regex humanizer fallback if the key is missing.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ADH_REWRITER_MODEL=gpt-4o-mini

# Groq
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# ADH_REWRITER_MODEL=llama-3.3-70b-versatile

# OpenRouter
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ADH_REWRITER_MODEL=openai/gpt-4o-mini

# Ollama (local; key can stay empty)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# ADH_REWRITER_MODEL=llama3.1

# ---------------------------------------------------------------------------
# Local detectors
# ---------------------------------------------------------------------------
# Where `adh models fetch` stores Raschka weights.
# Default: ~/.cache/adversarial-detector-humanizer/models/
# ADH_MODELS_DIR=

# Optional Hugging Face Hub token if downloads are rate-limited.
# HF_TOKEN=

# ---------------------------------------------------------------------------
# Remote detectors — not wired up yet
# ---------------------------------------------------------------------------
# GPTZero and Pangram will be added later. These names are reserved so you
# can keep keys in `.env` now; the open-core loop ignores them today.
# PANGRAM_API_KEY=
# GPTZERO_API_KEY=
